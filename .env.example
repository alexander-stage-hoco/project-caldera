# Project Caldera — Local Secrets
# Copy to .env and fill in values:  cp .env.example .env
# .env is gitignored. CI uses GitHub Actions secrets instead.

# LLM evaluation (make pipeline-eval, make tools-evaluate-llm)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Hetzner Cloud VMs (make cloud-run)
# https://console.hetzner.cloud → Project → Security → API Tokens
HCLOUD_TOKEN=

# GitHub IaC (make github-plan, make github-apply)
# Scopes: repo + admin:org (read), or fine-grained: Administration + Environments + Contents (write)
GITHUB_TOKEN=

# SonarQube external server (optional, auto-generated when using Docker)
SONAR_TOKEN=

# Results repository for archiving run artifacts (make export-results)
# Git URL (SSH or HTTPS) of a repository to store results
RESULTS_REPO_URL=
