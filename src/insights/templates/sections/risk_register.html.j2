<section id="{{ section_id }}" class="report-section">
    <h2>Risk Register</h2>

    {% if has_data %}
    <div class="metric-grid">
        <div class="metric-card">
            <div class="label">Total Risks</div>
            <div class="value">{{ total_risks }}</div>
        </div>
        <div class="metric-card">
            <div class="label">Critical</div>
            <div class="value" style="color: var(--color-critical);">{{ critical_count }}</div>
        </div>
        <div class="metric-card">
            <div class="label">High</div>
            <div class="value" style="color: var(--color-high);">{{ high_count }}</div>
        </div>
        <div class="metric-card">
            <div class="label">Medium</div>
            <div class="value">{{ medium_count }}</div>
        </div>
        {% if eval_quality_passed is not none %}
        <div class="metric-card">
            <div class="label">Eval Quality</div>
            <div class="value" style="color: {% if eval_quality_passed %}#2d6a2d{% else %}#b8860b{% endif %};">{% if eval_quality_passed %}PASS{% else %}CAUTION{% endif %}</div>
        </div>
        {% endif %}
    </div>

    {% for severity in ["critical", "high", "medium", "low"] %}
    {% set sev_risks = risks_by_severity[severity] %}
    {% if sev_risks %}
    <div class="subsection">
        <h3>{{ severity | upper }} Risks</h3>
        {% for risk in sev_risks %}
        <div class="risk-entry" style="border-left: 3px solid var(--color-{{ severity }}, #666); padding-left: 1rem; margin-bottom: 1.5rem;">
            <h4>{{ risk.risk_id }}: {{ risk.triggered_by }}
                <span style="font-size: 0.8em; font-weight: normal; margin-left: 0.5em; padding: 0.1em 0.4em; border-radius: 3px; background: {% if risk.status == 'resolved' %}#2d6a2d{% elif risk.status == 'mitigating' %}#6a5f2d{% elif risk.status == 'accepted' %}#4a4a4a{% else %}#6a2d2d{% endif %}; color: #fff;">{{ risk.status | default('open') }}</span>
                {% if risk.coherence_score is defined and risk.coherence_score %}<span style="font-size: 0.8em; font-weight: normal; margin-left: 0.5em; padding: 0.1em 0.4em; border-radius: 3px; background: {% if risk.coherence_score >= 4 %}#2d6a2d{% elif risk.coherence_score >= 3 %}#6a5f2d{% else %}#6a2d2d{% endif %}; color: #fff;">coherence {{ risk.coherence_score }}/5</span>{% endif %}
            </h4>
            <p><strong>Description:</strong> {{ risk.description_narrative or risk.description }}</p>
            <p><strong>Technical cause:</strong> {{ risk.technical_cause }}</p>
            {% if risk.owner or risk.action or risk.sla_date %}
            <p>
                {% if risk.owner %}<strong>Owner:</strong> {{ risk.owner }} &nbsp;{% endif %}
                {% if risk.action %}<strong>Action:</strong> {{ risk.action }} &nbsp;{% endif %}
                {% if risk.sla_date %}<strong>SLA:</strong> {{ risk.sla_date }}{% endif %}
            </p>
            {% endif %}
            <p><strong>Supporting claims:</strong> {{ risk.claim_count }}</p>

            {% if risk.claims %}
            <details>
                <summary>View claims</summary>
                <ul>
                {% for claim in risk.claims %}
                    <li><code>{{ claim.claim_id }}</code> — {{ claim.statement }} <em>({{ claim.confidence }})</em></li>
                {% endfor %}
                </ul>
            </details>
            {% endif %}

            {% if risk.manifests_in %}
            <details>
                <summary>Affected locations ({{ risk.manifests_in | length }})</summary>
                <ul>
                {% for loc in risk.manifests_in %}
                    <li><code>{{ loc }}</code></li>
                {% endfor %}
                </ul>
            </details>
            {% endif %}
        </div>
        {% endfor %}
    </div>
    {% endif %}
    {% endfor %}

    {% else %}
    <div class="empty-state">
        <p>No execution risks identified in this run.</p>
    </div>
    {% endif %}
</section>
