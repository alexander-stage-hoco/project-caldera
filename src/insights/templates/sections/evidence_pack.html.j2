<section id="{{ section_id }}" class="report-section">
    <h2>Evidence Pack</h2>

    {% if has_data %}
    <div class="metric-grid">
        <div class="metric-card">
            <div class="label">Total Evidence Items</div>
            <div class="value">{{ total_evidence }}</div>
        </div>
    </div>

    {% for cat in categories %}
    {% if cat.evidence_items %}
    <div class="subsection">
        <h3>{{ cat.category | title }} ({{ cat.total_count }}{% if cat.truncated %}, showing {{ cat.displayed_count }}{% endif %}){% if cat.category_quality_score %} <span style="font-size: 0.8em; font-weight: normal; padding: 0.1em 0.4em; border-radius: 3px; background: {% if cat.category_quality_score >= 4 %}#2d6a2d{% elif cat.category_quality_score >= 3 %}#6a5f2d{% else %}#6a2d2d{% endif %}; color: #fff;">quality {{ cat.category_quality_score }}/5</span>{% endif %}</h3>
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Location</th>
                    <th>Observation</th>
                    <th>Tool</th>
                    <th>Confidence</th>
                </tr>
            </thead>
            <tbody>
            {% for item in cat.evidence_items %}
                <tr>
                    <td><code>{{ item.evidence_id }}</code></td>
                    <td><code>{{ item.location }}</code></td>
                    <td>{{ item.observation }}</td>
                    <td>{{ item.tool_source }}</td>
                    <td>{{ item.confidence }}</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
    {% endfor %}

    {% else %}
    <div class="empty-state">
        <p>No evidence items collected in this run.</p>
    </div>
    {% endif %}
</section>
