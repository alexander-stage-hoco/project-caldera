# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit secrets.
#
# SECRETS: hcloud_token and anthropic_api_key are loaded from .env via TF_VAR_*
# environment variables. See .env.example in the project root.

# Required: Git URL of the Caldera project itself (so the VM can clone it)
# This should be the URL of YOUR fork/copy of this repository.
caldera_repo_url = "https://github.com/yourorg/caldera.git"

# Optional: Override defaults
# server_type          = "cx32"         # cx22=2vCPU/4GB, cx32=4/8, cx42=8/16
# location             = "fsn1"         # fsn1, nbg1, hel1, ash
# caldera_branch       = "main"
# skip_tools           = ""
# pipeline_llm         = 0
# max_parallel         = 4
# results_dir          = "./results"

# SSH key paths — defaults to ed25519. If you use RSA or another key type,
# uncomment and set these to match your key:
#   ls ~/.ssh/id_*  # to see your available keys
# ssh_public_key_path  = "~/.ssh/id_ed25519.pub"
# ssh_private_key_path = "~/.ssh/id_ed25519"
#
# Examples for RSA keys:
# ssh_public_key_path  = "~/.ssh/id_rsa.pub"
# ssh_private_key_path = "~/.ssh/id_rsa"
