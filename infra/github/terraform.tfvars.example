# GitHub repository settings
# Copy to terraform.tfvars and fill in values:
#   cp terraform.tfvars.example terraform.tfvars

github_owner      = "your-org-or-username"
github_repository = "your-repo-name"

# Usernames that must approve llm-eval environment deployments (Gate E)
# Leave empty [] to skip reviewer requirement
llm_eval_reviewers = ["your-username"]

# Usernames that must approve cloud environment deployments (cloud smoke)
# Leave empty [] to skip reviewer requirement
cloud_reviewers = ["your-username"]

# Auth: GITHUB_TOKEN comes from .env in the project root (see .env.example).
# The Makefile exports it automatically. You can also set it directly:
#   export GITHUB_TOKEN=ghp_...
# Required scopes: repo (full) + admin:org (read)
# Or fine-grained: Administration (write), Environments (write), Contents (write)
